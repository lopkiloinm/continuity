# Register at https://sandbox.auth.world.org/portal. Never commit .env.
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# Must match registration; supported: client_secret_basic or client_secret_post.
WORLD_AUTH_METHOD=client_secret_basic

# Required on Vercel. The Upstash integration injects KV_REST_API_URL/TOKEN
# or UPSTASH_REDIS_REST_URL/TOKEN. Local development defaults to memory.
# SESSION_ENCRYPTION_KEY=<Fernet.generate_key() value; backend only>
# APP_ORIGIN=https://your-production-project.vercel.app
